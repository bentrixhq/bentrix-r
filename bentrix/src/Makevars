# The BENTRIX C ABI: its header (BENTRIX_FFI_INCLUDE, crates/bentrix-ffi/include) and its library
# (BENTRIX_FFI_DIR, the folder holding libbentrix), found again at run time through its rpath.
PKG_CPPFLAGS = -I$(BENTRIX_FFI_INCLUDE)
PKG_LIBS = -L$(BENTRIX_FFI_DIR) -lbentrix -Wl,-rpath,$(BENTRIX_FFI_DIR)
